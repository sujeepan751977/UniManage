<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - UniManage</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 4.6.2 CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    
    <!-- Font Awesome 6.4.0 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/Content/unimanage.css?v=@DateTime.Now.Ticks">
    
    @RenderSection("styles", required: false)
</head>
<body class="@(ViewBag.HideSidebar == true ? "landing-mode" : "")">
    @if (ViewBag.HideSidebar == true)
    {
        <nav class="landing-navbar" id="landing-navbar">
            <div class="container d-flex align-items-center justify-content-between">
                <a href="/" class="landing-logo text-decoration-none">
                    <i class="fa-solid fa-graduation-cap text-primary"></i>
                    <span>UniManage</span>
                </a>
                
                <div class="nav-links-premium d-none d-md-flex">
                    <a href="#features" class="nav-link-premium">Features</a>
                    <a href="#about" class="nav-link-premium">About</a>
                    <a href="@Url.Action("Login", "Account")" class="nav-link-premium">Sign In</a>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-pill py-2 px-4 ml-2">Get Started</a>
                </div>

                <button class="btn btn-link text-white d-md-none">
                    <i class="fa-solid fa-bars fa-lg"></i>
                </button>
            </div>
        </nav>

        <script>
            window.addEventListener('scroll', function() {
                const nav = document.getElementById('landing-navbar');
                if (window.scrollY > 50) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
            });
        </script>
    }
    <div class="wrapper">
        <!-- Sidebar -->
        @if (ViewBag.HideSidebar != true)
        {
            <nav class="sidebar">
            <div class="sidebar-header">
                <i class="fa-solid fa-graduation-cap fa-xl text-primary"></i>
                <span class="sidebar-logo-text">UniManage</span>
            </div>
            
            <div class="sidebar-user">
                <div class="avatar-md">
                    @if (User.Identity.IsAuthenticated)
                    {
                        var name = User.Identity.Name.Substring(0, 1).ToUpper();
                        <span>@name</span>
                    }
                </div>
                <span class="user-name">@User.Identity.Name</span>
                @if (User.IsInRole("Administrator"))
                {
                    <span class="role-badge role-admin">Administrator</span>
                }
                else if (User.IsInRole("Lecturer"))
                {
                    <span class="role-badge role-lecturer">Lecturer</span>
                }
                else if (User.IsInRole("Student"))
                {
                    <span class="role-badge role-student">Student</span>
                }
            </div>

            <div class="sidebar-nav">
                @if (User.IsInRole("Student"))
                {
                    <a href="@Url.Action("Dashboard", "Student")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Student" && ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-gauge"></i> <span class="nav-label">Dashboard</span>
                    </a>
                    <a href="@Url.Action("MyCourses", "Student")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "MyCourses" ? "active" : "")">
                        <i class="fa-solid fa-book-open"></i> <span class="nav-label">My Courses</span>
                    </a>
                    <a href="@Url.Action("BrowseCourses", "Student")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "BrowseCourses" ? "active" : "")">
                        <i class="fa-solid fa-search"></i> <span class="nav-label">Browse Courses</span>
                    </a>
                    <a href="@Url.Action("Assignments", "Student")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Assignments" ? "active" : "")">
                        <i class="fa-solid fa-file-alt"></i> <span class="nav-label">Assignments</span>
                    </a>
                    <a href="@Url.Action("MyGrades", "Student")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "MyGrades" ? "active" : "")">
                        <i class="fa-solid fa-star"></i> <span class="nav-label">My Grades</span>
                    </a>
                }
                else if (User.IsInRole("Lecturer"))
                {
                    <a href="@Url.Action("Dashboard", "Lecturer")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Lecturer" && ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-gauge"></i> <span class="nav-label">Dashboard</span>
                    </a>
                    <a href="@Url.Action("MyCourses", "Lecturer")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "MyCourses" ? "active" : "")">
                        <i class="fa-solid fa-chalkboard"></i> <span class="nav-label">My Courses</span>
                    </a>
                    <a href="@Url.Action("Assignments", "Lecturer")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Assignments" ? "active" : "")">
                        <i class="fa-solid fa-tasks"></i> <span class="nav-label">Assignments</span>
                    </a>
                    <a href="@Url.Action("Reports", "Lecturer")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Reports" ? "active" : "")">
                        <i class="fa-solid fa-chart-bar"></i> <span class="nav-label">Reports</span>
                    </a>
                }
                else if (User.IsInRole("Administrator"))
                {
                    <a href="@Url.Action("Dashboard", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Admin" && ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa-solid fa-gauge"></i> <span class="nav-label">Dashboard</span>
                    </a>
                    <a href="@Url.Action("Courses", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Courses" ? "active" : "")">
                        <i class="fa-solid fa-graduation-cap"></i> <span class="nav-label">Courses</span>
                    </a>
                    <a href="@Url.Action("PendingEnrollments", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "PendingEnrollments" ? "active" : "")">
                        <i class="fa-solid fa-user-check"></i> <span class="nav-label">Enrollments</span>
                        @Html.Action("SidebarStats", "Admin")
                    </a>
                    <a href="@Url.Action("Batches", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Batches" ? "active" : "")">
                        <i class="fa-solid fa-layer-group"></i> <span class="nav-label">Batches</span>
                    </a>
                    <a href="@Url.Action("Users", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Users" ? "active" : "")">
                        <i class="fa-solid fa-users"></i> <span class="nav-label">Users</span>
                    </a>
                    <a href="@Url.Action("AuditLogs", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "AuditLogs" ? "active" : "")">
                        <i class="fa-solid fa-list-check"></i> <span class="nav-label">Audit Logs</span>
                    </a>
                    <a href="@Url.Action("Reports", "Admin")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Reports" ? "active" : "")">
                        <i class="fa-solid fa-chart-bar"></i> <span class="nav-label">Reports</span>
                    </a>
                }
                
                <a href="@Url.Action("Inbox", "Messages")" class="nav-link-custom @(ViewContext.RouteData.Values["controller"].ToString() == "Messages" ? "active" : "")">
                    <i class="fa-solid fa-envelope"></i> <span class="nav-label">Messages</span>
                </a>
            <div class="sidebar-footer">
                <a href="@Url.Action("Profile", "Account")" class="nav-link-custom @(ViewContext.RouteData.Values["action"].ToString() == "Profile" && ViewContext.RouteData.Values["controller"].ToString() == "Account" ? "active" : "")">
                    <i class="fa-solid fa-user-gear"></i> <span class="nav-label">My Profile</span>
                </a>
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                {
                    @Html.AntiForgeryToken()
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="nav-link-custom text-danger">
                        <i class="fa-solid fa-right-from-bracket"></i> <span class="nav-label">Sign Out</span>
                    </a>
                }
            </div>
        </nav>
        }

        <!-- Main Content -->
        <main class="main-content @(ViewBag.HideSidebar == true ? "m-0" : "")">
            @if (ViewBag.HideSidebar != true)
            {
                <header class="top-navbar">
                <div class="d-flex align-items-center">
                    <button id="mobile-toggle" class="btn btn-light d-md-none mr-3">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <button id="sidebar-toggle" class="btn btn-light d-none d-md-block mr-3">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h1 class="page-title">@ViewBag.Title</h1>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative d-none d-lg-block mr-3">
                        <input type="text" class="form-control rounded-pill bg-light border-0" placeholder="Search..." style="width: 280px; padding-left: 40px;">
                        <i class="fa-solid fa-search position-absolute text-muted" style="left: 16px; top: 12px;"></i>
                    </div>
                    
                    <div class="position-relative mr-3" id="notification-bell">
                        <i class="fa-solid fa-bell fa-lg text-secondary pointer"></i>
                        <span class="badge badge-primary position-absolute rounded-circle" style="top: -8px; right: -8px; font-size: 10px;">3</span>
                    </div>

                    <div class="dropdown">
                        @if (User.Identity.IsAuthenticated)
                        {
                            var initial = User.Identity.Name.Substring(0, 1).ToUpper();
                            <div class="avatar-sm m-0 dropdown-toggle pointer" data-toggle="dropdown">
                                <span class="avatar-initials">@initial</span>
                            </div>
                        }
                        else
                        {
                            <div class="avatar-sm m-0 dropdown-toggle pointer" data-toggle="dropdown">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }
                        <div class="dropdown-menu dropdown-menu-right border-0 shadow-lg mt-3">
                            <a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="fa-solid fa-user mr-2"></i> Profile</a>
                            <a class="dropdown-item" href="@Url.Action("Settings", "Home")"><i class="fa-solid fa-cog mr-2"></i> Settings</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-danger" href="javascript:document.getElementById('logoutForm').submit()"><i class="fa-solid fa-door-open mr-2"></i> Sign Out</a>
                        </div>
                    </div>
                </div>
            </header>
            }

            <div class="content-body fade-in">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center mb-4">
                        <i class="fa-solid fa-circle-check fa-lg mr-3"></i>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="close ml-auto" data-dismiss="alert">&times;</button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4">
                        <i class="fa-solid fa-circle-xmark fa-lg mr-3"></i>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="close ml-auto" data-dismiss="alert">&times;</button>
                    </div>
                }
                
                @RenderBody()
            </div>

            @if (ViewBag.HideSidebar == true)
            {
                <footer class="landing-footer py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 mb-5 mb-lg-0 pr-lg-5">
                                <a href="/" class="landing-logo text-decoration-none mb-4 d-inline-flex">
                                    <i class="fa-solid fa-graduation-cap text-primary"></i>
                                    <span>UniManage</span>
                                </a>
                                <p class="text-muted small mt-3" style="line-height: 1.8;">
                                    The ultimate platform for modern institutional management. 
                                    Streamlining academics, administration, and student life in one secure ecosystem.
                                </p>
                                <div class="d-flex gap-3 mt-4">
                                    <a href="#" class="text-secondary"><i class="fa-brands fa-twitter fa-lg"></i></a>
                                    <a href="#" class="text-secondary mx-3"><i class="fa-brands fa-linkedin-in fa-lg"></i></a>
                                    <a href="#" class="text-secondary"><i class="fa-brands fa-github fa-lg"></i></a>
                                </div>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2 mb-4 mb-md-0">
                                <h6 class="text-white font-weight-bold mb-4">Resources</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a href="#" class="text-muted small">Documentation</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">API Reference</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">Academic Guides</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2 mb-4 mb-md-0">
                                <h6 class="text-white font-weight-bold mb-4">Portals</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a href="@Url.Action("Login", "Account")" class="text-muted small">Staff Login</a></li>
                                    <li class="mb-2"><a href="@Url.Action("Login", "Account")" class="text-muted small">Student Portal</a></li>
                                    <li class="mb-2"><a href="@Url.Action("Register", "Account")" class="text-muted small">Registration</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="text-white font-weight-bold mb-4">Legal</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a href="#" class="text-muted small">Privacy Policy</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">Terms of Service</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">Audit Standards</a></li>
                                </ul>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <h6 class="text-white font-weight-bold mb-4">Support</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><a href="#" class="text-muted small">Help Center</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">Contact Us</a></li>
                                    <li class="mb-2"><a href="#" class="text-muted small">Status</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="border-top border-secondary-light mt-5 pt-4 d-flex justify-content-between align-items-center">
                            <div class="text-muted small">&copy; @DateTime.Now.Year UniManage Enterprise. All rights reserved.</div>
                            <div class="text-muted small">v1.2.0 – Built with Stability</div>
                        </div>
                    </div>
                </footer>
            }
            else
            {
                <footer class="footer">
                    <div>&copy; @DateTime.Now.Year UniManage – Modern University Course Management</div>
                    <div>v1.0.0</div>
                </footer>
            }
        </main>
    </div>

    <!-- Scripts -->
    <!-- jQuery 3.6.0 CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Popper.js and Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js 4.4.1 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Custom JS -->
    <script src="~/Scripts/unimanage.js"></script>
    
    <!-- Global Chart Config -->
    <script>
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.font.size = 13;
        Chart.defaults.color = '#6B7280';
        Chart.defaults.plugins.legend.position = 'bottom';
        
        window.chartColors = ['#4F46E5', '#0EA5E9', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#14B8A6', '#F97316', '#6366F1'];
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
