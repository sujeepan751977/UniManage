@model dynamic

<div class="text-center py-5">
    <div class="mb-4">
        <i class="fa-solid @(ViewBag.Icon ?? "fa-folder-open") fa-4x text-light" style="color: #E5E7EB !important;"></i>
    </div>
    <h3 class="h4 text-muted mb-2">@(ViewBag.Heading ?? "Nothing here yet")</h3>
    <p class="text-muted mb-4 mx-auto" style="max-width: 400px;">
        @(ViewBag.Subtext ?? "We couldn't find any data to display here. Try adding something new or check back later!")
    </p>
    @if (ViewBag.ActionText != null)
    {
        <a href="@ViewBag.ActionUrl" class="btn btn-primary">
            <i class="fa-solid fa-plus mr-2"></i> @ViewBag.ActionText
        </a>
    }
</div>
