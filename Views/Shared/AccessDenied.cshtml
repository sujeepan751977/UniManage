@{
    ViewBag.Title = "Access Denied";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="fa-solid fa-shield-halved fa-5x text-danger animate-pulse"></i>
    </div>
    <h1 class="h1 mb-3">Wait, You Can't Go There!</h1>
    <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
        It looks like you don't have the required permissions to access this page. 
        If you believe this is a mistake, please contact your administrator.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <button onclick="history.back()" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left mr-2"></i> Go Back
        </button>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
            <i class="fa-solid fa-house mr-2"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
@@keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.05); opacity: 0.8; }
    100% { transform: scale(1); opacity: 1; }
}
.animate-pulse {
    animation: pulse 2s infinite ease-in-out;
}
</style>
