@model UniManage.Models.BatchListViewModel
@using UniManage.Models

@{
    ViewBag.Title = "Batch Management";
}

<div class="container-fluid p-0">
    <!-- Header with Filters -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex gap-3 align-items-center">
            @using (Html.BeginForm("Batches", "Admin", FormMethod.Get, new { @class = "form-inline", id = "filterForm" }))
            {
                <div class="input-group mr-2">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-white border-right-0"><i class="fa-solid fa-graduation-cap text-muted"></i></span>
                    </div>
                    @Html.DropDownListFor(m => m.SelectedCourseId, Model.Courses, "All Courses", new { @class = "form-control border-left-0", onchange = "$('#filterForm').submit();" })
                </div>
                
                <div class="btn-group btn-group-toggle" data-toggle="buttons">
                    <label class="btn btn-pill-left btn-outline-primary @(!Model.SelectedStatus.HasValue ? "active" : "")">
                        <input type="radio" name="status" value="" @(!Model.SelectedStatus.HasValue ? "checked" : "") onchange="$('#filterForm').submit();"> All
                    </label>
                    <label class="btn btn-outline-primary @(Model.SelectedStatus == BatchStatus.Upcoming ? "active" : "")">
                        <input type="radio" name="status" value="Upcoming" @(Model.SelectedStatus == BatchStatus.Upcoming ? "checked" : "") onchange="$('#filterForm').submit();"> Upcoming
                    </label>
                    <label class="btn btn-pill-right btn-outline-primary @(Model.SelectedStatus == BatchStatus.Active ? "active" : "")">
                        <input type="radio" name="status" value="Active" @(Model.SelectedStatus == BatchStatus.Active ? "checked" : "") onchange="$('#filterForm').submit();"> Active
                    </label>
                </div>
            }
        </div>
        <a href="@Url.Action("CreateBatch", "Admin", new { courseId = Model.SelectedCourseId })" class="btn btn-primary btn-pill px-4">
            <i class="fa-solid fa-plus-circle mr-2"></i> Create New Batch
        </a>
    </div>

    @if (Model.Batches.Any())
    {
        <div class="row">
            @foreach (var batch in Model.Batches)
            {
                <div class="col-xl-4 col-md-6 mb-4">
                    <div class="glass-card h-100 border-0 shadow-sm transition-hover">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge @(batch.Status == BatchStatus.Active ? "badge-soft-success" : batch.Status == BatchStatus.Upcoming ? "badge-soft-primary" : "badge-soft-secondary") mb-2">
                                        @batch.Status
                                    </span>
                                    <h5 class="font-weight-bold mb-1">@batch.BatchName</h5>
                                    <div class="text-muted small">@batch.BatchCode • @batch.CourseCode</div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-icon btn-light" data-toggle="dropdown">
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right border-0 shadow">
                                        <a class="dropdown-item" href="@Url.Action("BatchDetail", "Admin", new { id = batch.BatchId })"><i class="fa-solid fa-users mr-2"></i> Manage Students</a>
                                        <a class="dropdown-item" href="@Url.Action("EditBatch", "Admin", new { id = batch.BatchId })"><i class="fa-solid fa-edit mr-2"></i> Edit Batch</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger" href="javascript:confirmDeleteBatch(@batch.BatchId)"><i class="fa-solid fa-trash mr-2"></i> Delete</a>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6">
                                    <div class="text-muted small mb-1">Schedule:</div>
                                    <div class="text-dark font-weight-500 small">@batch.StartDate.ToString("MMM dd") - @batch.EndDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="col-6 text-right">
                                    <div class="text-muted small mb-1">Lecturer:</div>
                                    <div class="text-primary font-weight-bold small"><i class="fa-solid fa-chalkboard-user mr-1"></i> @batch.LecturerName</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>Duration:</span>
                                    <span class="text-dark font-weight-500">@batch.DurationInWeeks.ToString("0.0") Weeks</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted small">
                                    <span>Waitlist Check:</span>
                                    <span class="text-dark font-weight-500">@(batch.DaysUntilStart > 0 ? batch.DaysUntilStart + " days til start" : "Started")</span>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-end mb-2">
                                    <div class="small">
                                        <span class="font-weight-bold text-dark">@batch.EnrolledCount</span>
                                        <span class="text-muted">/ @batch.MaxCapacity Enrolled</span>
                                    </div>
                                    <div class="small text-muted">@((int)((double)batch.EnrolledCount/batch.MaxCapacity * 100))% Capacity</div>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 4px;">
                                    @{
                                        var percent = (double)batch.EnrolledCount / batch.MaxCapacity * 100;
                                        string colorClass = percent >= 90 ? "bg-danger" : percent >= 70 ? "bg-warning" : "bg-primary";
                                    }
                                    <div class="progress-bar @colorClass" style="width: @percent%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                            <a href="@Url.Action("BatchDetail", "Admin", new { id = batch.BatchId })" class="btn btn-outline-primary btn-block btn-pill btn-sm">
                                Manage Students
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card text-center py-5">
            <div class="py-5">
                <i class="fa-solid fa-layer-group fa-4x text-light mb-4"></i>
                <h4 class="text-muted font-weight-bold">No Batches Found</h4>
                <p class="text-muted">Create your first course cohort to start organizing students.</p>
                <a href="@Url.Action("CreateBatch", "Admin")" class="btn btn-primary btn-pill px-5 mt-3">
                    <i class="fa-solid fa-plus mr-2"></i> Create First Batch
                </a>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        function confirmDeleteBatch(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Deleting a batch will remove all student assignments from this batch (enrollments won't be deleted).",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                cancelButtonColor: '#6B7280',
                confirmButtonText: 'Yes, delete batch'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteBatch", "Admin")', { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function() { location.reload(); });
                }
            });
        }
    </script>
}
