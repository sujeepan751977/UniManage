@model UniManage.ViewModels.Admin.EditUserViewModel
@{
    ViewBag.Title = "Edit User - " + Model.FirstName;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom hero-animate-up">
            <div class="card-header-custom mb-4">
                <h3 class="h4 mb-0">Update User Account</h3>
                <p class="text-muted small">Modifying account details for @Model.Email</p>
            </div>

            @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">First Name</label>
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "John" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">Last Name</label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Doe" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "user@unimanage.edu" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">Account Role</label>
                        @Html.DropDownListFor(m => m.Role, new SelectList(new[] { "Administrator", "Lecturer", "Student" }), "Select Role", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">NIC Number</label>
                        @Html.TextBoxFor(m => m.NIC, new { @class = "form-control", placeholder = "e.g. 123456789V" })
                        @Html.ValidationMessageFor(m => m.NIC, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="small font-weight-bold">Phone Number</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0771234567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 form-group">
                        <label class="small font-weight-bold">Date of Birth</label>
                        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="small font-weight-bold">Permanent Address</label>
                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control", placeholder = "Full Address", rows = 2 })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                </div>

                <div class="alert alert-info py-2 small d-flex align-items-center mb-4">
                    <i class="fa-solid fa-circle-info mr-2"></i>
                    Only provide a new password if you wish to reset it.
                </div>

                <div class="form-group mb-4">
                    <label class="small font-weight-bold">New Password (Reset)</label>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Leave blank to keep current" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="mt-4 border-top pt-4 d-flex justify-content-between">
                    <a href="@Url.Action("Users")" class="btn btn-light shadow-sm"><i class="fas fa-arrow-left mr-1"></i> Back to Directory</a>
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        <i class="fas fa-save mr-1"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>
