@model UniManage.ViewModels.Admin.PendingEnrollmentsViewModel

@{
    ViewBag.Title = "Pending Enrollments";
}

<div class="container-fluid p-0">
    <!-- Stat Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="glass-card stat-card border-0 mb-0 h-100">
                <div class="stat-icon bg-soft-primary text-primary">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div class="stat-content">
                    <h5 class="stat-value">@Model.TotalPending</h5>
                    <p class="stat-label">Total Requested</p>
                </div>
                <div class="stat-badge badge-primary">
                    <i class="fa-solid fa-arrow-up mr-1"></i> Waiting
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-card border-0 mb-0 h-100">
                <div class="stat-icon bg-soft-success text-success">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
                <div class="stat-content">
                    <h5 class="stat-value">@Model.TodayCount</h5>
                    <p class="stat-label">New Requests Today</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card stat-card border-0 mb-0 h-100">
                <div class="stat-icon bg-soft-info text-info">
                    <i class="fa-solid fa-calendar-week"></i>
                </div>
                <div class="stat-content">
                    <h5 class="stat-value">@Model.ThisWeekCount</h5>
                    <p class="stat-label">This Week</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Card -->
    <div class="glass-card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-dark">Enrollment Verification Queue</h5>
            <div class="d-flex gap-2">
                <button type="button" id="btnBulkApprove" class="btn btn-primary btn-pill px-4" disabled>
                    <i class="fa-solid fa-check-double mr-2"></i> Bulk Approve
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="pendingTable">
                <thead class="bg-light">
                    <tr>
                        <th width="40" class="text-center">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="checkAll">
                                <label class="custom-control-label" for="checkAll"></label>
                            </div>
                        </th>
                        <th>Student Information</th>
                        <th>Course Details</th>
                        <th>Requested On</th>
                        <th>Status / Checks</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input enrollment-check" id="check-@item.EnrollmentId" value="@item.EnrollmentId">
                                    <label class="custom-control-label" for="check-@item.EnrollmentId"></label>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm mr-3 bg-soft-primary text-primary">
                                        @item.StudentFullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-weight-bold">@item.StudentFullName</div>
                                        <div class="small text-muted">@item.StudentEmail</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="font-weight-600">@item.CourseCode</div>
                                <div class="small text-muted">@item.CourseTitle</div>
                            </td>
                            <td>
                                <div class="small">@item.EnrolledAt.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@item.EnrolledAt.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                @if (item.HasMetPrerequisites)
                                {
                                    <span class="badge badge-soft-success">
                                        <i class="fa-solid fa-check-circle mr-1"></i> Prerequisites Met
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger" title="Missing: @string.Join(", ", item.MissingPrerequisites)">
                                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Missing Pre-reqs
                                    </span>
                                }
                                <div class="mt-1 small">
                                    <span class="text-muted">Capacity:</span> 
                                    <span class="@(item.CurrentActiveCount >= item.CourseMaxEnrollment ? "text-danger font-weight-bold" : "text-dark")">
                                        @item.CurrentActiveCount / @item.CourseMaxEnrollment
                                    </span>
                                </div>
                            </td>
                            <td class="text-right">
                                <button type="button" class="btn btn-icon btn-soft-success mr-2" onclick="showApproveModal(@item.EnrollmentId, '@item.StudentFullName', '@item.CourseCode')">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button type="button" class="btn btn-icon btn-soft-danger" onclick="showRejectModal(@item.EnrollmentId, '@item.StudentFullName', '@item.CourseCode')">
                                    <i class="fa-solid fa-times"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-clipboard-check fa-3x mb-3 opacity-25"></i>
                                <p>No pending enrollments found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0">
            @using (Html.BeginForm("ApproveEnrollment", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="enrollmentId" id="approveEnrollmentId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title font-weight-bold">Approve Enrollment</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body py-4">
                    <p>Are you sure you want to approve <span id="approveStudentName" class="font-weight-bold"></span> for <span id="approveCourseCode" class="font-weight-bold"></span>?</p>
                    <div class="form-group mb-0">
                        <label class="small font-weight-bold text-muted">Internal Admin Notes (Optional)</label>
                        <textarea name="adminNotes" class="form-control" rows="3" placeholder="Add notes for future reference..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light btn-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-pill px-4">Confirm Approval</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0">
            @using (Html.BeginForm("RejectEnrollment", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="enrollmentId" id="rejectEnrollmentId" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title font-weight-bold text-danger">Reject Enrollment</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body py-4">
                    <p>Rejecting <span id="rejectStudentName" class="font-weight-bold"></span> from <span id="rejectCourseCode" class="font-weight-bold"></span>.</p>
                    <div class="form-group mb-0">
                        <label class="small font-weight-bold text-muted">Rejection Reason (Visible to Student) <span class="text-danger">*</span></label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Example: Missing prerequisite documents or payment issue."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light btn-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-pill px-4">Reject Request</button>
                </div>
            }
        </div>
    </div>
</div>

@using (Html.BeginForm("BulkApprove", "Admin", FormMethod.Post, new { id = "bulkApproveForm" }))
{
    @Html.AntiForgeryToken()
    <div id="bulkInputs"></div>
}

@section scripts {
    <script>
        function showApproveModal(id, name, course) {
            $('#approveEnrollmentId').val(id);
            $('#approveStudentName').text(name);
            $('#approveCourseCode').text(course);
            $('#approveModal').modal('show');
        }

        function showRejectModal(id, name, course) {
            $('#rejectEnrollmentId').val(id);
            $('#rejectStudentName').text(name);
            $('#rejectCourseCode').text(course);
            $('#rejectModal').modal('show');
        }

        $(document).ready(function() {
            $('#checkAll').change(function() {
                $('.enrollment-check').prop('checked', $(this).prop('checked'));
                updateBulkButton();
            });

            $('.enrollment-check').change(updateBulkButton);

            function updateBulkButton() {
                const count = $('.enrollment-check:checked').length;
                $('#btnBulkApprove').prop('disabled', count === 0);
                $('#btnBulkApprove').html(`<i class="fa-solid fa-check-double mr-2"></i> Bulk Approve (${count})`);
            }

            $('#btnBulkApprove').click(function() {
                const selected = $('.enrollment-check:checked').map(function() { return $(this).val(); }).get();
                if (selected.length > 0) {
                    Swal.fire({
                        title: 'Bulk Approval',
                        text: `Are you sure you want to approve ${selected.length} selected enrollments?`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, bulk approve',
                        confirmButtonColor: '#4F46E5',
                        cancelButtonColor: '#6B7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const container = $('#bulkInputs');
                            container.empty();
                            selected.forEach(id => {
                                container.append(`<input type="hidden" name="enrollmentIds" value="${id}" />`);
                            });
                            $('#bulkApproveForm').submit();
                        }
                    });
                }
            });
        });
    </script>
}
