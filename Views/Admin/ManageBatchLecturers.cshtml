@model UniManage.Models.BatchLecturerViewModel

@{
    ViewBag.Title = "Manage Batch Lecturers";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="glass-card border-0 shadow-sm p-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div class="btn-icon bg-soft-primary text-primary mr-3">
                    <i class="fa-solid fa-chalkboard-teacher"></i>
                </div>
                <div>
                    <h4 class="font-weight-bold mb-1">Manage Lecturers: @Model.BatchName</h4>
                    <p class="text-muted small m-0">
                        <span class="mr-3"><i class="fa-solid fa-tag mr-1"></i> Batch: @Model.BatchCode</span>
                        <span><i class="fa-solid fa-graduation-cap mr-1"></i> Course: @Model.CourseTitle</span>
                    </p>
                </div>
            </div>
            <div>
                <a href="@Url.Action("BatchDetail", "Admin", new { id = Model.BatchId })" class="btn btn-light btn-pill px-4">Back to Batch Details</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Assigned Lecturers -->
    <div class="col-lg-7 mb-4">
        <div class="glass-card border-0 shadow-sm h-100 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="m-0 font-weight-bold text-dark"><i class="fa-solid fa-user-check text-success mr-2"></i> Currently Assigned</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Lecturer</th>
                            <th>Role</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lecturer in Model.CurrentLecturers)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-soft-secondary text-secondary mr-3">@lecturer.Initials</div>
                                        <div>
                                            <div class="font-weight-bold">@lecturer.FullName</div>
                                            <div class="small text-muted">@lecturer.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (lecturer.IsPrimary)
                                    {
                                        <span class="badge badge-pill badge-primary px-3">Primary Instructor</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pill badge-light px-3 text-muted border">Assistant</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <button type="button" class="btn btn-icon btn-soft-danger" onclick="confirmRemove(@lecturer.BatchLecturerId, '@lecturer.FullName')">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.CurrentLecturers.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-user-slash fa-3x mb-3 opacity-25"></i>
                                    <p>No lecturers assigned to this batch yet.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Assign New Lecturer -->
    <div class="col-lg-5 mb-4">
        <div class="glass-card border-0 shadow-sm p-4 h-100">
            <h6 class="font-weight-bold mb-4 text-dark"><i class="fa-solid fa-user-plus text-primary mr-2"></i> Assign New Lecturer</h6>
            
            @if (Model.AvailableLecturers.Any())
            {
                using (Html.BeginForm("AssignBatchLecturer", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="batchId" value="@Model.BatchId" />
                    
                    <div class="form-group">
                        <label class="text-muted small font-weight-bold text-uppercase">Select Lecturer</label>
                        @Html.DropDownList("lecturerId", Model.AvailableLecturers, "Choose a lecturer...", new { @class = "form-control custom-select-lg", required = "required" })
                    </div>
                    
                    <div class="form-group mb-4">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="isPrimary" name="isPrimary" value="true">
                            <label class="custom-control-label font-weight-bold" for="isPrimary">Set as Primary Instructor</label>
                            <p class="small text-muted mt-1">Primary instructors have full control over assignment releases and student feedback. Other assigned lecturers act as assistants.</p>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-block btn-lg shadow-sm">
                        <i class="fa-solid fa-plus mr-2"></i> Assign to Batch
                    </button>
                }
            }
            else
            {
                <div class="text-center py-4 bg-light rounded shadow-sm border border-dashed">
                    <i class="fa-solid fa-circle-info text-primary mb-2"></i>
                    <p class="small m-0">All available lecturers are already assigned to this batch.</p>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        function confirmRemove(id, name) {
            Swal.fire({
                title: 'Remove Lecturer?',
                text: `Are you sure you want to remove ${name} from this batch? They will no longer have access to this cohort's Gradebook or Content.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF4444',
                confirmButtonText: 'Yes, remove them'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('removeAssignmentId').value = id;
                    document.getElementById('removeForm').submit();
                }
            });
        }
    </script>
}

@using (Html.BeginForm("RemoveBatchLecturer", "Admin", FormMethod.Post, new { id = "removeForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="removeAssignmentId" />
}
