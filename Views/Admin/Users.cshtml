@model UniManage.ViewModels.Admin.UserListViewModel
@{
    ViewBag.Title = "User Directory";
}

<div class="d-flex justify-content-between align-items-center mb-4 hero-animate-up">
    <div>
        <h1 class="h3 font-weight-bold mb-0">System User Directory</h1>
        <p class="text-muted small mb-0">Search, filter, and manage all institutional accounts</p>
    </div>
    <a href="@Url.Action("AddUser", "Admin")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus mr-2"></i> Add New User
    </a>
</div>

<div class="card-custom mb-4 hero-animate-up" style="animation-delay: 0.1s;">
    @using (Html.BeginForm("Users", "Admin", FormMethod.Get, new { @class = "row align-items-end" }))
    {
        <div class="col-md-4 mb-3 mb-md-0">
            <label class="small font-weight-bold text-muted text-uppercase">Search Records</label>
            <div class="position-relative">
                <input type="text" name="searchTerm" class="form-control pl-5" placeholder="Name or email..." value="@Model.SearchTerm">
                <i class="fa-solid fa-search position-absolute text-muted" style="left: 16px; top: 12px;"></i>
            </div>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <label class="small font-weight-bold text-muted text-uppercase">Role Filter</label>
            <select name="role" class="form-control custom-select">
                <option value="">All Roles</option>
                <option value="Administrator" @(Model.Role == "Administrator" ? "selected" : "")>Administrator</option>
                <option value="Lecturer" @(Model.Role == "Lecturer" ? "selected" : "")>Lecturer</option>
                <option value="Student" @(Model.Role == "Student" ? "selected" : "")>Student</option>
            </select>
        </div>
        <div class="col-md-3 mb-3 mb-md-0">
            <label class="small font-weight-bold text-muted text-uppercase">Account Status</label>
            <select name="isActive" class="form-control custom-select">
                <option value="">All Statuses</option>
                <option value="true" @(Model.IsActive == true ? "selected" : "")>Active Only</option>
                <option value="false" @(Model.IsActive == false ? "selected" : "")>Inactive Only</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-dark btn-block">Filter</button>
        </div>
    }
</div>

<div class="card-custom p-0 overflow-hidden hero-animate-up" style="animation-delay: 0.2s;">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0">User Profile</th>
                    <th class="border-0">Role</th>
                    <th class="border-0">Contact</th>
                    <th class="border-0">ID Details</th>
                    <th class="border-0">Status</th>
                    <th class="border-0 text-right pr-4">Management</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="py-3 pl-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-sm mr-3" style="background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%); color: white;">
                                    @user.FirstName.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="font-weight-bold text-dark">@user.FullName</div>
                                    <div class="small text-muted">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (user.Roles.Any())
                            {
                                var roleId = user.Roles.First().RoleId;
                                var allRoles = ViewBag.AllRoles as List<Microsoft.AspNet.Identity.EntityFramework.IdentityRole>;
                                var roleName = allRoles?.FirstOrDefault(r => r.Id == roleId)?.Name ?? "Student";
                                <span class="role-badge @(roleName == "Administrator" ? "role-admin" : roleName == "Lecturer" ? "role-lecturer" : "role-student")">
                                    @roleName
                                </span>
                            }
                            else
                            {
                                <span class="role-badge role-student">Student</span>
                            }
                        </td>
                        <td>
                             <div class="small font-weight-bold"><i class="fa-solid fa-phone mr-1 opacity-50"></i> @user.PhoneNumber</div>
                        </td>
                        <td>
                            <div class="small font-weight-bold">NIC: @user.NIC</div>
                            <div class="small text-muted text-truncate" style="max-width: 150px;">@user.Address</div>
                        </td>
                        <td>
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input user-status-toggle" id="status-@user.Id" data-user-id="@user.Id" @(user.IsActive ? "checked" : "")>
                                <label class="custom-control-label small" for="status-@user.Id">@(user.IsActive ? "Active" : "Inactive")</label>
                            </div>
                        </td>
                        <td class="text-right pr-4">
                            <a href="@Url.Action("EditUser", "Admin", new { id = user.Id })" class="btn btn-light btn-sm mr-1" title="Edit Profile">
                                <i class="fas fa-edit text-primary"></i>
                            </a>
                            <button type="button" class="btn btn-light btn-sm delete-user-btn" data-user-id="@user.Id" data-email="@user.Email" title="Delete Account">
                                <i class="fas fa-trash text-danger"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using (Html.BeginForm("DeleteUser", "Admin", FormMethod.Post, new { id = "deleteUserForm" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteUserId">
}

@section scripts {
    <script>
        $(document).ready(function() {
            // Status Toggle
            $('.user-status-toggle').on('change', function() {
                var userId = $(this).data('user-id');
                var isActive = $(this).is(':checked');
                var label = $(this).siblings('label');
                
                $.post('@Url.Action("ToggleUserStatus", "Admin")', { 
                    id: userId, 
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                }, function(data) {
                    if (data.success) {
                        label.text(data.isActive ? 'Active' : 'Inactive');
                    } else {
                        $(this).prop('checked', !isActive);
                        Swal.fire('Error', 'Failed to update user status.', 'error');
                    }
                });
            });

            // Delete Confirmation
            $('.delete-user-btn').on('click', function() {
                var userId = $(this).data('user-id');
                var email = $(this).data('email');

                Swal.fire({
                    title: 'Permanent Deletion?',
                    text: "You are about to delete " + email + ". This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, Delete Account',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#deleteUserId').val(userId);
                        $('#deleteUserForm').submit();
                    }
                });
            });
        });
    </script>
}
