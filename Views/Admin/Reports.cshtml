@model IEnumerable<UniManage.Models.BatchAnalyticsVM>

@{
    ViewBag.Title = "Administrative Reports";
}

<div class="row">
    <div class="col-12">
        <div class="glass-card border-0 mb-4 overflow-hidden">
            <div class="card-header bg-white py-3 border-0">
                <ul class="nav nav-pills nav-pill-primary" id="reportTabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="pill" href="#batchAnalytics">
                            <i class="fa-solid fa-chart-line mr-2"></i> Batch Performance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="pill" href="#sysHealth">
                            <i class="fa-solid fa-heart-pulse mr-2"></i> System Health
                        </a>
                    </li>
                </ul>
            </div>
            
            <div class="tab-content">
                <!-- Batch Analytics Tab -->
                <div class="tab-pane fade show active" id="batchAnalytics">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Batch / Course</th>
                                    <th>Progress</th>
                                    <th>Capacity</th>
                                    <th>Performance</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="font-weight-bold">@batch.BatchName</div>
                                            <div class="small text-muted">@batch.CourseTitle</div>
                                            <div class="mt-1">
                                                <span class="badge @(batch.Status == "Active" ? "badge-soft-success" : "badge-soft-secondary") small">@batch.Status</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>Duration Progress</span>
                                                <span>@((int)batch.ProgressPercent)%</span>
                                            </div>
                                            <div class="progress" style="height: 6px; width: 140px;">
                                                <div class="progress-bar bg-primary" style="width: @batch.ProgressPercent%"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="mr-3">
                                                    <div class="font-weight-bold">@batch.StudentCount / @batch.Capacity</div>
                                                    <div class="small text-muted">@((int)batch.FillRate)% Fill Rate</div>
                                                </div>
                                                <div class="chart-circle" style="width: 40px; height: 40px;">
                                                    <canvas class="mini-doughnut" data-percent="@batch.FillRate"></canvas>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="mr-3">
                                                    @if (batch.AverageGrade.HasValue && batch.AverageGrade > 0)
                                                    {
                                                        <div class="font-weight-bold text-success">@batch.AverageGrade.Value.ToString("0.0")%</div>
                                                        <div class="small text-muted">Avg. Grade</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="small text-muted">No Data</div>
                                                    }
                                                </div>
                                                <i class="fa-solid fa-chart-bar text-soft-success fa-2x opacity-25"></i>
                                            </div>
                                        </td>
                                        <td class="text-right">
                                            <a href="#" class="btn btn-icon btn-soft-primary"><i class="fa-solid fa-download"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Sys Health Tab (Placeholder) -->
                <div class="tab-pane fade" id="sysHealth">
                    <div class="p-5 text-center text-muted">
                        <i class="fa-solid fa-server fa-3x mb-3 opacity-25"></i>
                        <p>System health monitoring and audit summaries will appear here.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            $('.mini-doughnut').each(function() {
                const percent = $(this).data('percent');
                new Chart(this, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [percent, 100 - percent],
                            backgroundColor: ['#4F46E5', '#f1f1f1'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        cutout: '75%',
                        plugins: { legend: { display: false }, tooltip: { enabled: false } }
                    }
                });
            });
        });
    </script>
}
