@model UniManage.Models.Course
@{
    ViewBag.Title = "Modules: " + Model.CourseCode;
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb bg-transparent px-0">
    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="@Url.Action("Courses")">Courses</a></li>
    <li class="breadcrumb-item active">@Model.CourseCode Modules</li>
  </ol>
</nav>

<div class="row">
    <div class="col-lg-4">
        <div class="card-custom sticky-top" style="top: 20px;">
            <div class="card-header-custom border-0 pb-0">
                <h4 class="h5 font-weight-bold">Add New Module</h4>
            </div>
            <div class="p-3">
                @using (Html.BeginForm("CreateModule", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseId" value="@Model.CourseId" />
                    
                    <div class="form-group">
                        <label class="small font-weight-bold">Module Code</label>
                        <input type="text" name="ModuleCode" class="form-control" placeholder="e.g. CS101" required />
                    </div>
                    
                    <div class="form-group">
                        <label class="small font-weight-bold">Module Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Introduction to Programming" required />
                    </div>

                    <div class="form-group">
                        <label class="small font-weight-bold">Description</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="small font-weight-bold">Assign Lecturer</label>
                        @Html.DropDownList("LecturerId", (SelectList)ViewBag.Lecturers, "-- Select Lecturer --", new { @class = "form-control", required = "required" })
                    </div>

                    <button type="submit" class="btn btn-primary btn-block mt-4">
                        <i class="fas fa-plus mr-1"></i> Create Module
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header-custom border-0 pb-0">
                <div>
                    <h4 class="h5 font-weight-bold">Modules for @Model.Title</h4>
                    <p class="text-muted small">@Model.Modules.Count units defined</p>
                </div>
            </div>

            <div class="table-custom-wrapper mt-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Lecturer</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Modules.Any())
                        {
                            foreach (var module in Model.Modules)
                            {
                                <tr>
                                    <td>
                                        <div class="font-weight-bold">@module.Title</div>
                                        <div class="small text-muted">@module.ModuleCode</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm m-0 mr-2" style="width: 24px; height: 24px; font-size: 10px;">
                                                <span>@module.Lecturer.FirstName[0]</span>
                                            </div>
                                            <span class="small">@module.Lecturer.FullName</span>
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        @using (Html.BeginForm("DeleteModule", "Admin", new { id = module.ModuleId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure? This will delete all materials and assignments in this module.')", @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-light btn-sm text-danger" title="Delete"><i class="fas fa-trash-alt"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted small">
                                    <i class="fas fa-info-circle mr-1"></i> No modules added to this course yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
