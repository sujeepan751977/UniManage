@model UniManage.Models.EditBatchViewModel

@{
    ViewBag.Title = "Edit Batch: " + Model.BatchCode;
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="glass-card border-0 shadow-lg p-0 overflow-hidden">
            <div class="card-header bg-white py-4 px-5 d-flex align-items-center">
                <div class="btn-icon bg-soft-info text-info mr-3">
                    <i class="fa-solid fa-edit"></i>
                </div>
                <div>
                    <h4 class="m-0 font-weight-bold text-dark">Refine Batch Settings</h4>
                    <p class="text-muted small m-0">Update schedule, capacity, or assigned lecturer for this cohort.</p>
                </div>
            </div>
            
            @using (Html.BeginForm("EditBatch", "Admin", FormMethod.Post, new { @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.BatchId)
                @Html.HiddenFor(m => m.CourseId)
                
                <div class="card-body p-5">
                    <div class="row">
                        <!-- Primary Info -->
                        <div class="col-md-7">
                            <h6 class="text-primary font-weight-bold mb-4">BATCH IDENTITY & STATUS</h6>
                            
                            <div class="form-group mb-4">
                                <label class="small font-weight-bold text-muted">Batch Status</label>
                                @Html.EnumDropDownListFor(m => m.Status, new { @class = "form-control form-control-lg border-0 bg-light" })
                                @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger small" })
                            </div>

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group mb-4">
                                        <label class="small font-weight-bold text-muted">Batch Name</label>
                                        @Html.TextBoxFor(m => m.BatchName, new { @class = "form-control form-control-lg border-0 bg-light" })
                                        @Html.ValidationMessageFor(m => m.BatchName, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-4">
                                        <label class="small font-weight-bold text-muted">Batch Code</label>
                                        @Html.TextBoxFor(m => m.BatchCode, new { @class = "form-control form-control-lg border-0 bg-light" })
                                        @Html.ValidationMessageFor(m => m.BatchCode, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label class="small font-weight-bold text-muted">Capacity (Students)</label>
                                        @Html.TextBoxFor(m => m.MaxCapacity, new { @class = "form-control form-control-lg border-0 bg-light", type = "number", min = "1", max = "200" })
                                        @Html.ValidationMessageFor(m => m.MaxCapacity, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label class="small font-weight-bold text-muted">Assigned Lecturer</label>
                                        @Html.DropDownListFor(m => m.LecturerId, (IEnumerable<SelectListItem>)ViewBag.Lecturers, "Select a lecturer...", new { @class = "form-control form-control-lg border-0 bg-light" })
                                        @Html.ValidationMessageFor(m => m.LecturerId, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mb-0">
                                <label class="small font-weight-bold text-muted">Internal Description (Optional)</label>
                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control border-0 bg-light", rows = "3" })
                            </div>
                        </div>

                        <!-- Schedule Info -->
                        <div class="col-md-5 pl-md-5 border-left">
                            <h6 class="text-primary font-weight-bold mb-4">CHRONOLOGY</h6>
                            
                            <div class="form-group mb-4">
                                <label class="small font-weight-bold text-muted">Commencement Date</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text border-0 bg-light"><i class="fa-solid fa-calendar-plus text-primary"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-lg border-0 bg-light", type = "date" })
                                </div>
                                @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small" })
                            </div>

                            <div class="form-group mb-4">
                                <label class="small font-weight-bold text-muted">Conclusion Date</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text border-0 bg-light"><i class="fa-solid fa-calendar-check text-success"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-lg border-0 bg-light", type = "date" })
                                </div>
                                @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })
                            </div>

                            <div class="mt-5 p-4 bg-soft-info rounded-lg border-info-light">
                                <h6 class="font-weight-bold text-dark small m-0"><i class="fa-solid fa-lock mr-2"></i> Integrity Note</h6>
                                <p class="text-muted small mt-2 mb-0">Changing the dates may affect student access to course materials. Ensure any schedule shifts are communicated to the cohort.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light p-4 d-flex justify-content-end gap-3 border-0">
                    <a href="@Url.Action("Batches", "Admin", new { courseId = Model.CourseId })" class="btn btn-light btn-pill px-5">Discard Changes</a>
                    <button type="submit" class="btn btn-info btn-pill px-5 text-white">
                        <i class="fa-solid fa-save mr-2"></i> Update Batch
                    </button>
                </div>
            }
        </div>
    </div>
</div>
