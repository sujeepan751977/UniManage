@model UniManage.Models.Course
@{
    ViewBag.Title = "Add New Course";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header-custom border-0 mb-4">
                <h3 class="h4 mb-0">Course Information</h3>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label class="font-weight-bold">Course Code</label>
                        @Html.TextBoxFor(m => m.CourseCode, new { @class = "form-control", placeholder = "CS101" })
                        @Html.ValidationMessageFor(m => m.CourseCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-8 form-group">
                        <label class="font-weight-bold">Course Title</label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Introduction to Computer Science" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Description</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                </div>

                <div class="row mt-4">
                    <div class="col-md-6 border-right">
                        <p class="small text-muted mb-0 pt-2"><i class="fas fa-info-circle mr-1"></i> Lecturers will be assigned to specific <strong>Modules</strong> after the course is created.</p>
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="font-weight-bold">Credits</label>
                        @Html.TextBoxFor(m => m.Credits, new { @class = "form-control", type = "number", min = "1", max = "10" })
                        @Html.ValidationMessageFor(m => m.Credits, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3 form-group">
                        <label class="font-weight-bold">Max Enrollment</label>
                        @Html.TextBoxFor(m => m.MaxEnrollment, new { @class = "form-control", type = "number", min = "1" })
                        @Html.ValidationMessageFor(m => m.MaxEnrollment, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="form-group border-top pt-4 text-right">
                    <a href="@Url.Action("Courses")" class="btn btn-light mr-2">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5">Publish Course</button>
                </div>
            }
        </div>
    </div>
</div>
