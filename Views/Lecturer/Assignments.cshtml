@model IEnumerable<UniManage.Models.Assignment>
@{
    var module = ViewBag.Module as UniManage.Models.Module;
    ViewBag.Title = "Assignments: " + module.ModuleCode;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="h4 mb-1">Assignments for @module.ModuleCode</h3>
        <p class="text-muted small mb-0">@module.Title (@module.Course.CourseCode)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ManageReleases", new { id = module.CourseId })" class="btn btn-outline-info mr-2">
            <i class="fa-solid fa-bullhorn mr-2"></i> Manage Releases
        </a>
        <button class="btn btn-primary" data-toggle="modal" data-target="#createAssignmentModal">
            <i class="fa-solid fa-plus mr-2"></i> Create Assignment
        </button>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        foreach (var a in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card-custom h-100">
                    <div class="d-flex justify-content-between mb-3">
                        <h4 class="h5 font-weight-bold mb-0">@a.Title</h4>
                        <span class="badge @(a.Deadline > DateTime.Now ? "badge-success" : "badge-secondary")">@(a.Deadline > DateTime.Now ? "OPEN" : "CLOSED")</span>
                    </div>
                    <p class="small text-muted mb-4 text-truncate-2">@a.Description</p>
                    
                    <div class="mb-4">
                        <div class="small text-muted mb-2">Released to:</div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (a.AssignmentReleases != null && a.AssignmentReleases.Any())
                            {
                                foreach (var release in a.AssignmentReleases)
                                {
                                    <span class="badge badge-soft-primary" title="@(release.CustomDeadline.HasValue ? "Deadline: " + release.CustomDeadline.Value.ToString("MMM dd") : "Std Deadline")">
                                        <i class="fa-solid fa-users mr-1"></i> @release.Batch.BatchCode
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge badge-light text-muted border border-dashed">Not Released</span>
                            }
                        </div>
                    </div>

                    <div class="d-flex mb-4">
                        <div class="mr-4">
                            <div class="small text-muted">Deadline</div>
                            <div class="font-weight-bold small">@a.Deadline.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div class="mr-4">
                            <div class="small text-muted">Submissions</div>
                            <div class="font-weight-bold small">@a.Submissions.Count</div>
                        </div>
                        <div>
                            <div class="small text-muted">Max Marks</div>
                            <div class="font-weight-bold small">@a.MaxMarks</div>
                        </div>
                    </div>

                    <div class="row no-gutters mt-auto">
                        <div class="col-6 pr-1">
                            <a href="@Url.Action("Submissions", new { id = a.AssignmentId })" class="btn btn-light btn-sm btn-block border transition-standard">
                                <i class="fa-solid fa-eye mr-1 text-primary"></i> Submissions
                            </a>
                        </div>
                        <div class="col-6 pl-1">
                            @using (Html.BeginForm("DeleteAssignment", "Lecturer", new { id = a.AssignmentId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure? This will also delete all student submissions for this assignment.');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-light btn-sm btn-block border text-danger transition-standard">
                                    <i class="fa-solid fa-trash-can mr-1"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            @Html.Partial("_EmptyState", new { Heading = "No assignments created", Subtext = "Create tasks and assessments to track student learning progress." })
        </div>
    }
</div>

<!-- Create Assignment Modal -->
<div class="modal fade" id="createAssignmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-weight-bold p-3">New Assignment Task</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            @using (Html.BeginForm("CreateAssignment", "Lecturer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ModuleId" value="@module.ModuleId" />
                <div class="modal-body p-4">
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group mb-4">
                                <label class="font-weight-bold small text-muted">Assignment Title</label>
                                <input type="text" name="Title" class="form-control" required placeholder="e.g. Mid-term Research Project">
                            </div>
                            <div class="form-group mb-4">
                                <label class="font-weight-bold small text-muted">Task Description</label>
                                <textarea name="Description" class="form-control" rows="4" required placeholder="Detailed instructions for students..."></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold small text-muted">Submission Deadline</label>
                                    <input type="datetime-local" name="Deadline" class="form-control" required>
                                </div>
                                <div class="col-md-6 form-group">
                                    <label class="font-weight-bold small text-muted">Maximum Points</label>
                                    <input type="number" name="MaxMarks" class="form-control" required value="100">
                                </div>
                            </div>
                            <div class="custom-control custom-switch mt-3">
                                <input type="checkbox" class="custom-control-input" id="allowLate" name="AllowLateSubmission" value="true">
                                <label class="custom-control-label small" for="allowLate">Permit Late Submissions</label>
                            </div>
                        </div>
                        <div class="col-md-5 border-left pl-md-4 text-center py-5">
                            <i class="fa-solid fa-bullhorn text-soft-primary fa-3x mb-4"></i>
                            <h6 class="font-weight-bold">Content Release Manager</h6>
                            <p class="small text-muted mb-4 px-2">After creation, you will be redirected to the Release Manager to define visibility and custom deadlines per batch.</p>
                            <div class="alert alert-soft-primary py-2 px-3 small border-0">
                                <i class="fa-solid fa-circle-info mr-2"></i> Cohort-specific logic enabled.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light btn-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-pill px-5">Publish Assignment</button>
                </div>
            }
        </div>
    </div>
</div>
