@model IEnumerable<UniManage.Models.Module>
@{
    ViewBag.Title = "My Teaching Portfolio";
}

<div class="row">
    @foreach (var module in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card-custom">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h3 class="h4 font-weight-bold mb-1">@module.Title</h3>
                        <div class="d-flex gap-2">
                           <span class="badge badge-primary">@module.ModuleCode</span>
                           <span class="small text-muted font-weight-bold">@module.Course.CourseCode</span>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm" type="button" data-toggle="dropdown">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="@Url.Action("CourseStudents", new { id = module.CourseId })"><i class="fa-solid fa-users mr-2"></i> View Students</a>
                            <div class="dropdown-divider"></div>
                            <p class="dropdown-item small text-muted mb-0">Part of @module.Course.Title</p>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6 text-center border-right">
                        <div class="h5 font-weight-bold mb-0">@module.Materials.Count</div>
                        <div class="small text-muted">Materials</div>
                    </div>
                    <div class="col-6 text-center">
                        <div class="h5 font-weight-bold mb-0">@module.Assignments.Count</div>
                        <div class="small text-muted">Assignments</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("Materials", new { id = module.ModuleId })" class="btn btn-secondary btn-sm flex-fill">
                        <i class="fa-solid fa-folder-open mr-1"></i> Materials
                    </a>
                    <a href="@Url.Action("Assignments", new { id = module.ModuleId })" class="btn btn-primary btn-sm flex-fill">
                        <i class="fa-solid fa-tasks mr-1"></i> Assignments
                    </a>
                </div>
            </div>
        </div>
    }
</div>
