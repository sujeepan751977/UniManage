@model IEnumerable<UniManage.ViewModels.Lecturer.StudentSearchVM>

@{
    ViewBag.Title = "Student Search";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="glass-card border-0 shadow-sm p-4">
            <div class="d-flex align-items-center mb-4">
                <div class="btn-icon bg-soft-primary text-primary mr-3">
                    <i class="fa-solid fa-users-viewfinder"></i>
                </div>
                <div>
                    <h4 class="font-weight-bold mb-1">Advanced Student Search</h4>
                    <p class="text-muted small m-0">Search through students in your assigned cohorts.</p>
                </div>
            </div>

            @using (Html.BeginForm("SearchStudents", "Lecturer", FormMethod.Get, new { @class = "row g-3" }))
            {
                <div class="col-md-5">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        </div>
                        <input type="text" name="query" class="form-control border-left-0" placeholder="Search by name or email..." value="@ViewBag.Query">
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="batchId" class="form-control custom-select">
                        <option value="">All My Batches</option>
                        @foreach (var batch in ViewBag.Batches)
                        {
                            <option value="@batch.BatchId" @(ViewBag.SelectedBatchId == batch.BatchId ? "selected" : "")>@batch.BatchCode (@batch.BatchName)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-block shadow-sm">
                        <i class="fa-solid fa-filter mr-2"></i> Apply Filters
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="glass-card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Student</th>
                            <th>Cohort / Course</th>
                            <th>Enrolled On</th>
                            <th class="text-right">Quick Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="font-weight-bold text-dark">@item.FullName</div>
                                    <div class="small text-muted">@item.Email</div>
                                </td>
                                <td>
                                    <div class="badge badge-soft-info px-3 mb-1">@item.BatchCode</div>
                                    <div class="small text-muted">@item.CourseTitle</div>
                                </td>
                                <td class="small">@item.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                <td class="text-right">
                                    <a href="mailto:@item.Email" class="btn btn-icon btn-soft-primary mr-1" title="Email Student">
                                        <i class="fa-solid fa-envelope"></i>
                                    </a>
                                    @* Future: Link to student portfolio or specific grades *@
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-user-slash fa-3x mb-3 opacity-25"></i>
                                    <p class="m-0">No students found matching your criteria.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
