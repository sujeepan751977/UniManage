@model UniManage.ViewModels.Lecturer.LecturerReportsViewModel
@{
    ViewBag.Title = "Academic Insights & Analytics";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card-custom text-center p-3 h-100">
            <div class="avatar-sm bg-soft-primary mx-auto mb-2"><i class="fa-solid fa-users"></i></div>
            <div class="h3 font-weight-bold text-primary mb-0">@Model.TotalEnrolledStudents</div>
            <div class="text-muted x-small uppercase font-weight-bold">Active Students</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center p-3 h-100">
            <div class="avatar-sm bg-soft-success mx-auto mb-2"><i class="fa-solid fa-chart-line"></i></div>
            <div class="h3 font-weight-bold text-success mb-0">@Model.AverageClassGrade.ToString("0.0")%</div>
            <div class="text-muted x-small uppercase font-weight-bold">Class Average</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center p-3 h-100">
            <div class="avatar-sm bg-soft-info mx-auto mb-2"><i class="fa-solid fa-check-double"></i></div>
            <div class="h3 font-weight-bold text-info mb-0">@Model.CompletedAssignments</div>
            <div class="text-muted x-small uppercase font-weight-bold">Graded Tasks</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-custom text-center p-3 h-100 border-primary" style="background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);">
            <div class="avatar-sm bg-primary text-white mx-auto mb-2"><i class="fa-solid fa-file-export"></i></div>
            <a href="javascript:void(0)" onclick="window.print()" class="h6 font-weight-bold text-primary mb-0 d-block">Export PDF Report</a>
            <div class="text-muted x-small uppercase font-weight-bold">Click to Print</div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card-custom h-100">
            <div class="card-header-custom border-0 pb-0 mb-4">
                <h3 class="h5 font-weight-bold"><i class="fa-solid fa-chart-bar mr-2 text-primary"></i>Grade Distribution</h3>
                <p class="text-muted small">Frequency of scores across all graded assessments.</p>
            </div>
            <div style="height: 300px; position: relative;">
                <canvas id="gradeDistChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card-custom h-100">
            <div class="card-header-custom border-0 pb-0 mb-4">
                <h3 class="h5 font-weight-bold"><i class="fa-solid fa-trophy mr-2 text-warning"></i>Top Performers</h3>
                <p class="text-muted small">Leading students by average grade.</p>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.TopStudents.Any())
                {
                    foreach (var student in Model.TopStudents)
                    {
                        <div class="list-group-item px-0 py-3 d-flex align-items-center border-light">
                            <div class="avatar-sm bg-light text-primary mr-3">@student.Name.Substring(0, 1)</div>
                            <div class="flex-grow-1">
                                <div class="small font-weight-bold text-dark">@student.Name</div>
                                <div class="x-small text-muted">@student.SubmissionsCount Submissions</div>
                            </div>
                            <div class="text-right">
                                <div class="font-weight-bold text-success">@student.AverageGrade.ToString("0.0")%</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-user-slash text-muted mb-2"></i>
                        <p class="small text-muted">No graded data yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="card-header-custom border-0 pb-0 mb-3 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="h5 font-weight-bold">Module Performance Breakdown</h3>
            <p class="text-muted small mb-0">Detailed engagement metrics per assigned module.</p>
        </div>
    </div>

    <div class="table-custom-wrapper">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Students</th>
                    <th>Average Grade</th>
                    <th>Analytics</th>
                    <th class="text-right">Export</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var module in Model.ModulePerformances)
                {
                    <tr>
                        <td style="width: 30%;">
                            <div class="font-weight-bold text-dark">@module.Title</div>
                            <div class="x-small text-muted font-weight-bold text-uppercase">@module.CourseCode • @module.ModuleCode</div>
                        </td>
                        <td>
                            <div class="font-weight-bold">@module.EnrollmentCount</div>
                            <div class="x-small text-muted">Total Enrolled</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="font-weight-bold mr-3 @(module.AverageGrade >= 70 ? "text-success" : (module.AverageGrade < 40 ? "text-danger" : "text-primary"))">
                                    @module.AverageGrade.ToString("0.0")%
                                </span>
                                <div class="progress flex-grow-1 shadow-xs" style="height: 6px; max-width: 100px;">
                                    <div class="progress-bar @(module.AverageGrade >= 75 ? "bg-success" : (module.AverageGrade >= 40 ? "bg-primary" : "bg-danger"))" 
                                         style="width: @(module.AverageGrade)%"></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small">
                                <span class="text-dark font-weight-bold">@module.SubmissionCount</span> <span class="text-muted">Graded</span>
                                <br />
                                @if (module.PendingGradingCount > 0)
                                {
                                    <span class="text-danger x-small font-weight-bold">@module.PendingGradingCount Action Required</span>
                                }
                                else
                                {
                                    <span class="text-success x-small"><i class="fa-solid fa-circle-check mr-1"></i> Finalized</span>
                                }
                            </div>
                        </td>
                        <td class="text-right">
                             <a href="@Url.Action("DownloadModuleReport", new { id = module.ModuleId })" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                 <i class="fa-solid fa-file-csv mr-1"></i> CSV
                             </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            const ctx = document.getElementById('gradeDistChart').getContext('2d');
            
            // Setup gradient
            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, '#4F46E5');
            gradient.addColorStop(1, '#0EA5E9');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['0-20%', '21-40%', '41-60%', '61-80%', '81-100%'],
                    datasets: [{
                        label: 'Number of Submissions',
                        data: @Html.Raw(Json.Encode(Model.GradeDistribution)),
                        backgroundColor: gradient,
                        borderRadius: 8,
                        hoverBackgroundColor: '#1E1B4B'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { drawBorder: false, color: '#F3F4F6' },
                            ticks: { stepSize: 1 }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        });
    </script>
}

<style>
    .bg-soft-primary { background-color: #EEF2FF; color: #4F46E5; }
    .bg-soft-success { background-color: #ECFDF5; color: #059669; }
    .bg-soft-info { background-color: #F0F9FF; color: #0EA5E9; }
    .shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .x-small { font-size: 0.7rem; }
    .list-group-item:last-child { border-bottom: 0; }
</style>
