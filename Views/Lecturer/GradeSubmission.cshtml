@model UniManage.ViewModels.Lecturer.GradeSubmissionViewModel
@{
    ViewBag.Title = "Grade Submission: " + Model.StudentName;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card-custom mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="h4 mb-0">Submission Review</h3>
                <span class="badge badge-pill @(Model.IsLate ? "status-danger" : "status-active")">@(Model.IsLate ? "Late Submission" : "On Time")</span>
            </div>
            
            <div class="p-4 bg-light rounded border mb-4">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-file-pdf fa-3x text-danger mr-4"></i>
                    <div>
                        <h4 class="h5 mb-1">@Model.FileName</h4>
                        <p class="small text-muted mb-3">Submitted on @Model.SubmittedAt.ToString("MMMM dd, yyyy @ hh:mm tt")</p>
                        <a href="@Model.FilePath" class="btn btn-primary btn-sm px-4" download>
                            <i class="fa-solid fa-download mr-2"></i> Download File
                        </a>
                    </div>
                </div>
            </div>

            @using (Html.BeginForm("GradeSubmission", "Lecturer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.SubmissionId)

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label class="font-weight-bold">Grade (Score / @Model.MaxMarks)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.Grade, new { @class = "form-control form-control-lg", type = "number", step = "0.5", min = "0", max = Model.MaxMarks })
                            <div class="input-group-append">
                                <span class="input-group-text bg-white">/@Model.MaxMarks</span>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold">Feedback to Student</label>
                    @Html.TextAreaFor(m => m.Feedback, new { @class = "form-control", rows = 6, placeholder = "Provide constructive feedback for the student..." })
                    @Html.ValidationMessageFor(m => m.Feedback, "", new { @class = "text-danger small" })
                </div>

                <div class="border-top pt-4 text-right">
                    <a href="@Url.Action("Submissions", new { id = Model.SubmissionId })" class="btn btn-light px-4 mr-2">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5">Submit Grade & Feedback</button>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-custom mb-4">
            <h4 class="small font-weight-bold text-uppercase text-muted mb-3">Student Context</h4>
            <div class="d-flex align-items-center mb-4">
                <div class="avatar-sm m-0 mr-3">@Model.StudentName.Substring(0, 1)</div>
                <div>
                    <div class="font-weight-bold">@Model.StudentName</div>
                    <div class="text-muted small">@Model.StudentEmail</div>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="small text-muted d-block mb-1">Assessment</label>
                <div class="font-weight-bold">@Model.AssignmentTitle</div>
            </div>

            <a href="@Url.Action("ComposeMessage", "Lecturer", new { receiverId = Model.StudentEmail })" class="btn btn-secondary btn-sm btn-block">
                <i class="fa-solid fa-envelope mr-2"></i> Message Student
            </a>
        </div>

        <div class="card-custom bg-light border-0">
            <h4 class="small font-weight-bold text-uppercase text-muted mb-3">Grading Rubric</h4>
            <ul class="small text-muted pl-3 mb-0">
                <li class="mb-2"><strong>90-100%:</strong> Exceptional work, exceeds expectations.</li>
                <li class="mb-2"><strong>75-89%:</strong> Strong performance, well-researched.</li>
                <li class="mb-2"><strong>60-74%:</strong> Satisfactory, meets basic requirements.</li>
                <li><strong>Below 60%:</strong> Needs improvement.</li>
            </ul>
        </div>
    </div>
</div>
