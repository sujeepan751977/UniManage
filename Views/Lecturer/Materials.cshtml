@model IEnumerable<UniManage.Models.CourseMaterial>
@{
    var module = ViewBag.Module as UniManage.Models.Module;
    ViewBag.Title = "Module Materials: " + module.ModuleCode;
}

<div class="card-custom">
    <div class="card-header-custom border-0 mb-4">
        <div>
            <h3 class="h4 mb-1">Module Materials</h3>
            <p class="text-muted small mb-0">Manage resources for <strong>@module.Title</strong> (@module.Course.CourseCode)</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ManageReleases", new { id = module.CourseId })" class="btn btn-outline-info mr-2">
                <i class="fa-solid fa-bullhorn mr-2"></i> Manage Releases
            </a>
            <button class="btn btn-primary" data-toggle="modal" data-target="#uploadModal">
                <i class="fa-solid fa-plus mr-2"></i> Upload New
            </button>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-custom-wrapper">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Target Cohorts</th>
                        <th>Type</th>
                        <th>Size</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-bold text-dark">@item.Title</div>
                                <div class="small text-muted text-truncate" style="max-width: 250px;">@item.Description</div>
                            </td>
                            <td>
                                @if (item.MaterialReleases != null && item.MaterialReleases.Any())
                                {
                                    foreach (var release in item.MaterialReleases)
                                    {
                                        <span class="badge badge-soft-info mr-1">@release.Batch.BatchCode</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-light text-muted border border-dashed">Not Released</span>
                                }
                            </td>
                            <td><span class="badge badge-light border">@item.FileType.ToUpper()</span></td>
                            <td><span class="small">@((item.FileSize / 1024.0 / 1024.0).ToString("F2")) MB</span></td>
                            <td class="text-right d-flex justify-content-end align-items-center">
                                <a href="@Url.Content(item.FilePath)" class="btn btn-light btn-sm mr-2" download title="Download">
                                    <i class="fa-solid fa-download text-primary"></i>
                                </a>
                                @using (Html.BeginForm("DeleteMaterial", "Lecturer", new { id = item.MaterialId }, FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this material?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-light btn-sm" title="Delete">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", new { Heading = "No materials uploaded", Subtext = "Upload syllabus, lecture notes, or readings to help your students." })
    }
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-weight-bold">Upload Course Material</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            @using (Html.BeginForm("UploadMaterial", "Lecturer", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="moduleId" value="@module.ModuleId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-7">
                            <div class="form-group">
                                <label class="font-weight-bold small text-muted">Resource Title</label>
                                <input type="text" name="title" class="form-control" required placeholder="e.g. Lecture 01 - Intro to C#">
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold small text-muted">Description (Optional)</label>
                                <textarea name="description" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold small text-muted">File Resource</label>
                                <input type="file" name="materialFile" class="form-control-file p-3 border rounded bg-light" required>
                                <small class="text-muted">Max size: 10MB. Formats: PDF, PPT, DOCX, ZIP.</small>
                            </div>
                        </div>
                        <div class="col-md-5 border-left">
                            <div class="text-center py-5">
                                <i class="fa-solid fa-bullhorn text-soft-info fa-3x mb-3"></i>
                                <h6 class="font-weight-bold">Batch Selection</h6>
                                <p class="small text-muted px-3">After you upload this file, you will be taken to the Release Manager to choose which cohorts can see it.</p>
                                <span class="badge badge-pill badge-info px-4">New Workflow</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light btn-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-pill px-5">Start Upload</button>
                </div>
            }
        </div>
    </div>
</div>
