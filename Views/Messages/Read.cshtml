@model UniManage.Models.Message
@{
    ViewBag.Title = "Read Message";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card-custom mb-4">
            <div class="card-header-custom border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <a href="@Url.Action("Inbox")" class="btn btn-light btn-sm mr-3"><i class="fa-solid fa-arrow-left"></i></a>
                    <h3 class="h5 mb-0 font-weight-bold">@Model.Subject</h3>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-light btn-sm"><i class="fa-solid fa-star"></i></button>
                    <button class="btn btn-light btn-sm"><i class="fa-solid fa-trash"></i></button>
                </div>
            </div>

            <div class="p-4">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="d-flex align-items-center">
                        @{
                            var initialRead = !string.IsNullOrEmpty(Model.Sender?.FullName) ? Model.Sender.FullName.Substring(0, 1).ToUpper() : "?";
                        }
                        <div class="avatar-sm m-0 mr-3" style="width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary), #6366f1); color: white; font-size: 1.2rem;">@initialRead</div>
                        <div>
                            <div class="font-weight-bold text-dark d-flex align-items-center">
                                @Model.Sender.FullName
                                <span class="badge badge-light border ml-2 small font-weight-normal text-muted" style="font-size: 10px;">@Model.Sender.Email</span>
                            </div>
                            <div class="small text-muted mt-1">
                                <i class="fa-solid fa-clock mr-1"></i> Received @Model.SentAt.ToString("MMM dd, yyyy @ HH:mm")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="message-body text-dark line-height-relaxed py-4 border-top">
                    @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                </div>

                <div class="mt-5 pt-4 border-top">
                    <div class="small text-muted mb-3 font-weight-bold text-uppercase">Reply to this message</div>
                    <a href="@Url.Action("Compose", new { receiverId = Model.SenderId, subject = "Re: " + Model.Subject })" class="btn btn-outline-primary btn-sm px-4">
                        <i class="fa-solid fa-reply mr-2"></i> Reply
                    </a>
                    <a href="#" class="btn btn-outline-secondary btn-sm px-4 ml-2">
                        <i class="fa-solid fa-share mr-2"></i> Forward
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
