@model UniManage.ViewModels.Account.ProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<div class="row">
    <div class="col-lg-4">
        <div class="card-custom text-center">
            <div class="position-relative d-inline-block mb-4">
                @if (string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <div class="avatar-lg shadow-sm mx-auto">
                        <span class="avatar-initials">@Model.FirstName.Substring(0, 1).ToUpper()</span>
                    </div>
                }
                else
                {
                    <img src="@Model.ProfilePicturePath" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid var(--white);">
                }
                <div class="position-absolute" style="bottom: 0; right: 0;">
                    <button class="btn btn-primary btn-sm rounded-circle p-2" onclick="$('#ProfilePicture').click()">
                        <i class="fa-solid fa-camera"></i>
                    </button>
                </div>
            </div>
            <h2 class="h3 mb-1">@Model.FirstName @Model.LastName</h2>
            <p class="text-muted small mb-4">@Model.Email</p>
            
            <div class="text-left border-top pt-4">
                <h4 class="small font-weight-bold text-uppercase text-muted mb-3">Bio</h4>
                <p class="text-muted small">
                    @(string.IsNullOrEmpty(Model.Bio) ? "No bio provided yet. Tell us something about yourself!" : Model.Bio)
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-custom">
            <div class="card-header-custom">
                <h3 class="h4 mb-0">Profile Settings</h3>
            </div>
            
            @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>First Name</label>
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Last Name</label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>NIC Number</label>
                        @Html.TextBoxFor(m => m.NIC, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.NIC, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Email Address (Read-only)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Permanent Address</label>
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 form-group">
                        <label>Phone Number</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0771234567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <label>Bio</label>
                    @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4, placeholder = "Brief description for your profile..." })
                    @Html.ValidationMessageFor(m => m.Bio, "", new { @class = "text-danger" })
                </div>

                <div class="form-group d-none">
                    <input type="file" name="ProfilePicture" id="ProfilePicture" accept="image/*" />
                </div>

                <div class="mt-4 border-top pt-4 text-right">
                    <button type="submit" class="btn btn-primary px-4">
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>
