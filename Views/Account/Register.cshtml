@model UniManage.ViewModels.Account.RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="auth-card" style="width: 480px;">
    <div class="text-center mb-4">
        <i class="fa-solid fa-graduation-cap fa-3x text-primary mb-2"></i>
        <h1 class="h2 font-weight-bold text-dark">Create Account</h1>
        <p class="text-muted">Start managing your courses today</p>
    </div>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

        <div class="row">
            <div class="col-md-6 form-group">
                <label>First Name</label>
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "John" })
                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6 form-group">
                <label>Last Name</label>
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Doe" })
                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small" })
            </div>
        </div>

        <div class="form-group">
            <label>Email Address</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "john.doe@university.edu" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        <div class="row">
            <div class="col-md-6 form-group">
                <label>NIC Number</label>
                @Html.TextBoxFor(m => m.NIC, new { @class = "form-control", placeholder = "e.g. 199012345678" })
                @Html.ValidationMessageFor(m => m.NIC, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-6 form-group">
                <label>Date of Birth</label>
                @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger small" })
            </div>
        </div>

        <div class="form-group">
            <label>Permanent Address</label>
            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", placeholder = "123 Street, City", rows = 2 })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0771234567" })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mb-2">
            <label>Password</label>
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "At least 8 characters", id = "Password" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            
            <div class="progress mt-2" style="height: 6px;">
                <div id="password-strength-meter" class="progress-bar" role="progressbar" style="width: 0%"></div>
            </div>
            <div id="password-strength-label" class="small mt-1 text-muted"></div>
        </div>

        <div class="form-group mb-4">
            <label>Confirm Password</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Re-type password" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
        </div>

        <button type="submit" class="btn btn-primary btn-block py-2 mb-4">
            Create Account
        </button>

        <div class="text-center">
            <p class="mb-0 text-muted small">Already have an account? <a href="@Url.Action("Login", "Account")" class="text-primary font-weight-bold">Sign In</a></p>
        </div>
    }
</div>
