@model UniManage.ViewModels.Student.BrowseCoursesViewModel
@{
    ViewBag.Title = "Browse Courses";
}

<div class="card-custom border-0 shadow-none mb-4" style="background-color: var(--primary-light);">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h2 class="h3 mb-2">Discover New Knowledge</h2>
            <p class="text-muted mb-0">Browse and enroll in the best university courses.</p>
        </div>
        <div class="col-md-5 mt-3 mt-md-0">
            @using (Html.BeginForm("BrowseCourses", "Student", FormMethod.Get))
            {
                <div class="input-group">
                    <input type="text" name="search" class="form-control border-0" placeholder="Search courses..." value="@Model.SearchQuery">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-search"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex gap-2 mb-4 overflow-auto pb-2">
    <a href="@Url.Action("BrowseCourses", "Student")" class="badge badge-pill py-2 px-3 @(string.IsNullOrEmpty(Model.FilterStatus) ? "bg-primary text-white" : "bg-white text-muted border")">All Courses</a>
    <a href="@Url.Action("BrowseCourses", "Student", new { filter = "Active" })" class="badge badge-pill py-2 px-3 @(Model.FilterStatus == "Active" ? "bg-primary text-white" : "bg-white text-muted border")">Active</a>
    <a href="@Url.Action("BrowseCourses", "Student", new { filter = "Available" })" class="badge badge-pill py-2 px-3 @(Model.FilterStatus == "Available" ? "bg-primary text-white" : "bg-white text-muted border")">Available Only</a>
</div>

<div class="row">
    @if (Model.Courses.Any())
    {
        foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card-custom h-100 p-0 overflow-hidden card-custom-interactive">
                    @{
                        var colors = new[] { "#4F46E5", "#0EA5E9", "#10B981", "#F59E0B", "#EF4444" };
                        var colorIndex = Math.Abs(course.CourseCode.GetHashCode()) % colors.Length;
                        var bannerColor = colors[colorIndex];
                    }
                    <div style="height: 120px; background-color: @bannerColor; position: relative;">
                        <div class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center">
                            <h2 class="h1 text-white mb-0 opacity-25" style="letter-spacing: 0.1em;">@course.CourseCode</h2>
                        </div>
                        <div class="position-absolute" style="bottom: 12px; left: 16px;">
                            <span class="badge badge-light shadow-sm">@course.Credits Credits</span>
                        </div>
                    </div>
                    
                    <div class="p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h5 font-weight-bold mb-0">@course.Title</h3>
                            <span class="small font-weight-bold text-muted">@course.CourseCode</span>
                        </div>
                        <p class="small text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;">
                            @course.Description
                        </p>
                        
                        <div class="d-flex align-items-center mb-4">
                            <div class="avatar-sm m-0 mr-2" style="width: 24px; height: 24px; font-size: 10px;">@course.LecturerName.Substring(0, 1)</div>
                            <span class="small text-muted">@course.LecturerName</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                            <div class="small">
                                <span class="text-primary font-weight-bold">@course.CurrentEnrollment</span>
                                <span class="text-muted">/@course.MaxEnrollment Enrolled</span>
                            </div>
                            
                            @if (course.IsEnrolled)
                            {
                                <span class="badge badge-pill badge-soft-success">
                                    <i class="fa-solid fa-check-circle mr-1"></i> Enrolled
                                </span>
                            }
                            else if (course.IsPending)
                            {
                                <span class="badge badge-pill badge-soft-warning">
                                    <i class="fa-solid fa-clock mr-1"></i> Pending Approval
                                </span>
                            }
                            else if (course.CurrentEnrollment >= course.MaxEnrollment)
                            {
                                <span class="badge badge-pill badge-soft-danger">Course Full</span>
                            }
                            else
                            {
                                using (Html.BeginForm("Enroll", "Student", new { courseId = course.CourseId }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-sm px-4 btn-pill">Enroll Now</button>
                                }
                            }
                        </div>
                        
                        @if (course.Prerequisites.Any())
                        {
                            <div class="mt-3">
                                <span class="small text-muted d-block mb-1">Prerequisites:</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var pre in course.Prerequisites)
                                    {
                                        <span class="badge badge-light border small text-muted">@pre</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            @Html.Partial("_EmptyState", new { Heading = "No courses found", Subtext = "Try searching for a different course code or title." })
        </div>
    }
</div>
