@model UniManage.ViewModels.Student.AssignmentSubmissionViewModel
@{
    ViewBag.Title = "Manage Submission";
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb bg-transparent px-0">
    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="@Url.Action("MyCourses")">My Courses</a></li>
    <li class="breadcrumb-item active">@Model.Title</li>
  </ol>
</nav>

<div class="row">
    <div class="col-lg-7">
        <div class="card-custom mb-4">
            <div class="card-header-custom border-0 pb-0">
                <span class="badge badge-light border mb-2">@Model.CourseTitle</span>
                <h2 class="h3 font-weight-bold">@Model.Title</h2>
            </div>
            <div class="p-0 mt-3">
                <p class="text-muted">@Model.Description</p>
            </div>
            
            <div class="row mt-4">
                <div class="col-md-6 border-right">
                    <div class="small text-muted font-weight-bold text-uppercase mb-2">Deadline</div>
                    <div class="h5 font-weight-bold @(Model.IsLate ? "text-danger" : "text-dark")">
                        <i class="fa-solid fa-clock mr-2"></i> @Model.Deadline.ToString("MMM dd, yyyy @ hh:mm tt")
                    </div>
                    <div id="countdown-timer" class="small mt-1" data-deadline="@Model.Deadline.ToString("O")"></div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted font-weight-bold text-uppercase mb-2">Max Marks</div>
                    <div class="h5 font-weight-bold text-dark">
                        <i class="fa-solid fa-star mr-2 text-warning"></i> @Model.MaxMarks Marks
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ExistingSubmission != null && Model.ExistingSubmission.Grade.HasValue)
        {
            <div class="card-custom border-success" style="background-color: #ECFDF5;">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center p-3 mr-3" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-check-to-slot fa-lg"></i>
                    </div>
                    <div>
                        <h3 class="h5 font-weight-bold mb-0">Graded Performance</h3>
                        <p class="small text-muted mb-0">Graded on @Model.ExistingSubmission.GradedAt.Value.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
                
                <div class="text-center py-4 bg-white rounded border mb-4">
                    <div class="display-4 font-weight-bold text-dark">@Model.ExistingSubmission.Grade <span class="h2 text-muted">/ @Model.MaxMarks</span></div>
                    <div class="font-weight-bold" style="color: @(Model.ExistingSubmission.Grade >= Model.MaxMarks * 0.8m ? "var(--success)" : "var(--primary)")">
                        @(((Model.ExistingSubmission.Grade / Model.MaxMarks) * 100)?.ToString("F1"))%
                    </div>
                </div>

                <div class="form-group">
                    <label class="small font-weight-bold text-muted text-uppercase">Lecturer Feedback</label>
                    <div class="p-3 bg-white rounded border small text-muted">
                        @(string.IsNullOrEmpty(Model.ExistingSubmission.Feedback) ? "No written feedback provided." : Model.ExistingSubmission.Feedback)
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        @if (Model.ExistingSubmission != null && !Model.ExistingSubmission.Grade.HasValue)
        {
            <div class="card-custom mb-4 border-primary" style="background-color: var(--primary-light);">
                <div class="d-flex align-items-center">
                    <i class="fa-solid fa-circle-info fa-lg text-primary mr-3"></i>
                    <div>
                        <div class="font-weight-bold text-primary">Status: Pending Review</div>
                        <div class="small text-muted">You submitted this on @Model.ExistingSubmission.SubmittedAt.ToString("MMM dd @ hh:mm tt")</div>
                    </div>
                </div>
            </div>
        }

        <div class="card-custom">
            <div class="card-header-custom">
                <h3 class="h4 mb-0">Upload Submission</h3>
            </div>
            
            @using (Html.BeginForm("SubmitAssignment", "Student", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.AssignmentId)

                if (Model.ExistingSubmission != null)
                {
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fa-solid fa-cloud-arrow-up mr-2"></i> 
                        Resubmitting will replace your previous file: <strong>@Model.ExistingSubmission.FileName</strong>
                    </div>
                }

                <div class="form-group">
                    <div class="dropzone-custom" id="dropzone">
                        <i class="fa-solid fa-cloud-arrow-up fa-3x text-light mb-3" style="color: #E5E7EB !important;"></i>
                        <p class="text-muted mb-0">Drag & drop your assignment file here</p>
                        <p class="small text-muted">or <span class="text-primary font-weight-bold pointer">Browse Files</span></p>
                        <input type="file" name="SubmissionFile" id="SubmissionFile" class="d-none" required />
                        <div id="file-preview" class="mt-3"></div>
                    </div>
                    @Html.ValidationMessageFor(m => m.SubmissionFile, "", new { @class = "text-danger small mt-2" })
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-block py-2">
                        <i class="fa-solid fa-paper-plane mr-2"></i> @(Model.ExistingSubmission == null ? "Submit Assignment" : "Update Submission")
                    </button>
                    @if (Model.ExistingSubmission != null)
                    {
                        <a href="@Model.ExistingSubmission.FilePath" class="btn btn-secondary btn-block mt-2" download>
                            <i class="fa-solid fa-download mr-2"></i> Download Current File
                        </a>
                    }
                </div>
            }
        </div>
        
        <div class="mt-4 card-custom bg-light border-0">
            <h4 class="small font-weight-bold text-uppercase text-muted mb-3">Submission Policy</h4>
            <ul class="small text-muted pl-3 mb-0">
                <li class="mb-2">Allowed types: .pdf, .docx, .zip, .rar</li>
                <li class="mb-2">Max file size: 10MB</li>
                <li>@(Model.IsLate ? "Late submissions are currently being accepted but will be flagged." : "Submissions after deadline are not allowed.")</li>
            </ul>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            var deadline = new Date($("#countdown-timer").data("deadline"));
            
            function updateTimer() {
                var now = new Date();
                var diff = deadline - now;
                
                if (diff <= 0) {
                    $("#countdown-timer").html("<span class='text-danger font-weight-bold'>Deadline Passed</span>");
                    return;
                }
                
                var days = Math.floor(diff / (1000 * 60 * 60 * 24));
                var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                
                var timerHtml = days + " days " + hours + " hours remaining";
                if (days === 0 && hours < 6) {
                    $("#countdown-timer").addClass("text-danger font-weight-bold animate-pulse");
                } else {
                    $("#countdown-timer").addClass("text-muted");
                }
                $("#countdown-timer").text(timerHtml);
            }
            
            updateTimer();
            setInterval(updateTimer, 60000);

            // Dropzone Logic
            $('#dropzone').on('click', function() {
                $('#SubmissionFile').click();
            });

            $('#SubmissionFile').on('click', function(e) {
                e.stopPropagation(); // Prevent double trigger from parent
            });

            $('#SubmissionFile').on('change', function() {
                var file = this.files[0];
                if (file) {
                    var fileName = file.name;
                    var fileSize = (file.size / 1024 / 1024).toFixed(2);
                    $('#file-preview').html(`
                        <div class="p-3 border rounded bg-white shadow-sm d-flex align-items-center animate-fade-in">
                            <div class="bg-primary-light p-2 rounded mr-3">
                                <i class="fa-solid fa-file-pdf text-primary fa-lg"></i>
                            </div>
                            <div class="mr-auto">
                                <div class="small font-weight-bold text-dark">${fileName}</div>
                                <div class="text-muted" style="font-size: 11px;">${fileSize} MB</div>
                            </div>
                            <i class="fa-solid fa-circle-check text-success fa-lg"></i>
                        </div>
                    `);
                    $('#dropzone').addClass('border-primary bg-light');
                }
            });

            // Drag and Drop
            $('#dropzone').on('dragover', function(e) {
                e.preventDefault();
                $(this).addClass('bg-primary-light border-primary');
            });

            $('#dropzone').on('dragleave', function() {
                $(this).removeClass('bg-primary-light border-primary');
            });

            $('#dropzone').on('drop', function(e) {
                e.preventDefault();
                $(this).removeClass('bg-primary-light border-primary');
                var files = e.originalEvent.dataTransfer.files;
                if (files.length > 0) {
                    $('#SubmissionFile')[0].files = files;
                    $('#SubmissionFile').trigger('change');
                }
            });
        });
    </script>
}
