@model IEnumerable<UniManage.ViewModels.Student.EnrolledCourseVM>
@{
    ViewBag.Title = "My Courses";
}

<div class="row">
    @if (Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card-custom h-100 p-0 overflow-hidden card-custom-interactive">
                    <div style="height: 120px; background-color: var(--primary-light); position: relative;">
                        <img src="@(string.IsNullOrEmpty(item.ThumbnailPath) ? "/Content/placeholder-course.png" : item.ThumbnailPath)" class="w-100 h-100" style="object-fit: cover; opacity: 0.1;">
                        <div class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="top: 0;">
                            <h2 class="h2 text-primary">@item.CourseCode</h2>
                        </div>
                        <div class="position-absolute" style="top: 12px; right: 16px;">
                            @{
                                string statusClass = "status-active";
                                if (item.Status == "Pending") { statusClass = "bg-warning text-white"; }
                                else if (item.Status == "Rejected") { statusClass = "bg-danger text-white"; }
                                else if (item.Status == "Dropped") { statusClass = "status-dropped"; }
                            }
                            <span class="badge badge-pill @statusClass">@item.Status</span>
                        </div>
                    </div>
                    
                    <div class="p-4">
                        <h3 class="h2 font-weight-bold mb-1">@item.Title</h3>
                        <p class="small text-muted mb-4">Instructor: @item.LecturerName</p>
                        
                        @if (item.Status == "Pending")
                        {
                            <div class="alert alert-soft-warning border-0 small mb-4">
                                <i class="fa-solid fa-clock mr-1"></i> Awaiting administrative approval.
                            </div>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <div class="alert alert-soft-danger border-0 small mb-4">
                                <i class="fa-solid fa-circle-xmark mr-1"></i> <strong>Rejected:</strong> @item.RejectionReason
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Course Progress</span>
                                    <span>@item.ProgressPercentage%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar" role="progressbar" style="width: @item.ProgressPercentage%"></div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted">@item.Credits Credits</span>
                            @if (item.Status == "Active")
                            {
                                <a href="@Url.Action("CourseDetail", "Student", new { id = item.CourseId })" class="btn btn-secondary btn-sm">Enter Course</a>
                            }
                            else
                            {
                                <button class="btn btn-light btn-sm text-muted" disabled>Locked</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            @Html.Partial("_EmptyState", new { 
                Heading = "You aren't enrolled in any courses", 
                Subtext = "Browse our course catalog to find something that interests you and start learning today!",
                ActionText = "Browse Courses",
                ActionUrl = Url.Action("BrowseCourses", "Student"),
                Icon = "fa-book"
            })
        </div>
    }
</div>
