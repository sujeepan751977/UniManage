@model IEnumerable<UniManage.Models.AssignmentReleaseVM>
@{
    ViewBag.Title = "My Academic Timeline";
    var submissions = (List<UniManage.Models.Submission>)ViewBag.Submissions;
}

<div class="glass-card mb-4 border-0 shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h3 mb-1 font-weight-bold">Academic Roadmap</h2>
            <p class="text-muted small mb-0">Cohort-specific deadlines and tasks across all your enrolled courses.</p>
        </div>
        <div class="text-right">
            <div class="h3 font-weight-bold text-primary mb-0">@Model.Count()</div>
            <div class="small text-muted uppercase font-weight-bold">Active Tasks</div>
        </div>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        foreach (var release in Model)
        {
            var assignment = release.Assignment;
            var deadline = release.CustomDeadline ?? assignment.Deadline;
            var submission = submissions.FirstOrDefault(s => s.AssignmentId == assignment.AssignmentId);
            var isSubmitted = submission != null;
            var isLate = DateTime.Now > deadline;
            
            <div class="col-lg-6 mb-4">
                <div class="card-custom h-100 transition-standard border-0 shadow-sm hover-up overflow-hidden">
                    <div class="card-header-highlight @(isSubmitted ? "bg-success" : (isLate ? "bg-danger" : "bg-primary"))"></div>
                    <div class="p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge badge-soft-primary px-3 py-1 mb-2">@assignment.Module.Course.CourseCode</span>
                                <h3 class="h5 font-weight-bold mb-1">@assignment.Title</h3>
                                <p class="text-muted small mb-0">@assignment.Module.Title</p>
                            </div>
                            <div class="text-right">
                                @if (isSubmitted)
                                {
                                    <span class="status-pill bg-soft-success text-success"><i class="fa-solid fa-check-circle mr-1"></i> Done</span>
                                }
                                else if (isLate)
                                {
                                    <span class="status-pill bg-soft-danger text-danger"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Overdue</span>
                                }
                                else
                                {
                                    <span class="status-pill bg-soft-primary text-primary"><i class="fa-solid fa-hourglass-half mr-1"></i> Active</span>
                                }
                            </div>
                        </div>

                        <div class="bg-gray-50 p-3 rounded-lg mb-4 border" style="min-height: 70px;">
                            <p class="small text-muted mb-0 line-clamp-2">@assignment.Description</p>
                        </div>

                        <div class="row no-gutters mb-4">
                            <div class="col-6">
                                <div class="small text-muted mb-1"><i class="fa-solid fa-calendar mr-1"></i> Target Deadline</div>
                                <div class="font-weight-bold @(isLate && !isSubmitted ? "text-danger" : "text-dark")">@deadline.ToString("MMM dd, yyyy")</div>
                                @if (release.CustomDeadline.HasValue)
                                {
                                    <div class="badge badge-soft-info x-small mt-1">Cohort-Specific</div>
                                }
                            </div>
                            <div class="col-6 text-right">
                                <div class="small text-muted mb-1"><i class="fa-solid fa-star mr-1"></i> Weightage</div>
                                <div class="font-weight-bold text-dark">@assignment.MaxMarks Points</div>
                            </div>
                        </div>

                        <div class="mt-2">
                            <a href="@Url.Action("SubmitAssignment", new { id = assignment.AssignmentId })" 
                               class="btn @(isSubmitted ? "btn-outline-success" : (isLate ? "btn-danger" : "btn-primary")) btn-block rounded-pill py-2 shadow-sm transition-standard">
                                <i class="fa-solid @(isSubmitted ? "fa-eye" : "fa-file-arrow-up") mr-2"></i>
                                @(isSubmitted ? "Review Submission" : (isLate ? "Submit Late" : "Open Task"))
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="glass-card d-inline-block p-5 border-0 shadow-sm">
                <i class="fa-solid fa-clipboard-check fa-4x text-soft-primary mb-4"></i>
                <h4 class="h5 text-dark font-weight-bold">Clear Horizon</h4>
                <p class="text-muted small">No assignments have been released to your cohort yet. Enjoy the breather!</p>
            </div>
        </div>
    }
</div>

<style>
    .hover-up:hover { transform: translateY(-5px); transition: 0.3s ease; }
    .card-header-highlight { height: 4px; width: 100%; position: absolute; top: 0; left: 0; }
    .status-pill { font-size: 10px; padding: 4px 12px; border-radius: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .bg-gray-50 { background-color: #F9FAFB; }
    .x-small { font-size: 10px; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
